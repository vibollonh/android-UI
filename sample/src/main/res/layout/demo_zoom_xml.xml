<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="BaseZoomTransition.present(activity, cardView, fragment)"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <!-- Card rows are added in code from the same data as the Compose demo. -->

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drag_down"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Drag down (shrinks and follows)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drag_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Drag right (slides and zooms out)" />
    </LinearLayout>
</ScrollView>
